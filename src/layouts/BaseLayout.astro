---
import { ViewTransitions } from 'astro:transitions';
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | 3ds Max学习日志</title>
  <meta name="description" content="记录3ds Max建模、材质、渲染学习过程">
  <ViewTransitions />
</head>
<body class="bg-slate-50 text-slate-800">
  <nav class="bg-dark text-white px-6 py-4">
    <div class="max-w-5xl mx-auto flex justify-between items-center">
      <a href="/" class="text-xl font-bold">3ds Max学习日志</a>
      <div class="space-x-6">
        <a href="/">首页</a>
        <a href="/posts">笔记列表</a>
        <a href="/gallery">作品画廊</a>
        <a href="/tags">标签</a>
        <a href="/about">关于</a>
      </div>
    </div>
  </nav>

  <main class="max-w-5xl mx-auto px-4 py-10">
    <slot />
  </main>

  <footer class="bg-dark text-white text-center py-6 mt-10">
    <p>个人3ds Max学习记录 · 静态博客</p>
  </footer>
</body>
</html>
