---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = await getCollection('posts');
const sortedPosts = posts.sort((a,b) => b.data.date.getTime() - a.data.date.getTime()).slice(0,4);
---
<BaseLayout title="首页">
  <section class="mb-10">
    <h1 class="text-4xl font-bold mb-4">欢迎来到我的3ds Max学习博客</h1>
    <p class="text-lg text-slate-600">记录建模、UV、材质、灯光渲染踩坑笔记，保存练习作品，追踪学习进度。</p>
  </section>

  <h2 class="text-2xl font-semibold mb-4">最新笔记</h2>
  <div class="grid md:grid-cols-2 gap-6">
    {sortedPosts.map(post => (
      <a href={`/posts/${post.slug}`} class="border p-4 rounded-lg hover:shadow-md transition">
        <h3 class="font-bold text-lg">{post.data.title}</h3>
        <p class="text-sm text-slate-500">{post.data.date.toLocaleDateString()}</p>
        <div class="flex flex-wrap gap-2 mt-2">
          {post.data.tags.map(tag => <span class="bg-blue-100 text-blue-700 px-2 rounded text-xs">{tag}</span>)}
        </div>
      </a>
    ))}
  </div>
  <div class="mt-8">
    <a href="/posts" class="text-primary underline">查看全部笔记 →</a>
  </div>
</BaseLayout>
