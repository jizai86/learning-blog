---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = await getCollection('posts');
const sortedPosts = posts.sort((a,b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout title="笔记列表">
  <h1 class="text-3xl font-bold mb-8">全部学习笔记</h1>
  <div class="space-y-6">
    {sortedPosts.map(post => (
      <div class="border p-5 rounded-lg">
        <a href={`/posts/${post.slug}`} class="text-xl font-bold text-primary hover:underline">{post.data.title}</a>
        <p class="text-sm text-slate-500 mt-1">{post.data.date.toLocaleDateString()}</p>
        <div class="flex flex-wrap gap-2 mt-2">
          {post.data.tags.map(tag => <span class="bg-blue-100 text-blue-700 px-2 rounded text-xs">{tag}</span>)}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
