---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="作品画廊">
  <h1 class="text-3xl font-bold mb-8">3ds Max练习作品</h1>
  <p class="mb-6">在这里放你的模型渲染截图，图片放到public/images文件夹。</p>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="border rounded-lg overflow-hidden">
      <img src="/images/cube01.png" alt="立方体基础练习" class="w-full h-48 object-cover"/>
      <div class="p-3">
        <p class="font-medium">基础几何体练习</p>
      </div>
    </div>
  </div>
</BaseLayout>
